# Copy to .env.local and fill in.

# Public site origin, used for canonical URLs / sitemap / OpenGraph.
# Set this to the custom domain once one is live (e.g. https://nablucknow.org).
NEXT_PUBLIC_SITE_URL=https://nablucknow.vercel.app

# Google Apps Script web-app URL that receives every form submission.
# Deploy the script in google-apps-script/Code.gs as a Web App
# (Execute as: Me, Who has access: Anyone), then paste its /exec URL here.
# When empty, forms still show their confirmation but nothing is written
# to the sheet.
NEXT_PUBLIC_FORMS_ENDPOINT=
